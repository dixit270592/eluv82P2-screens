# Base path for assets and router (default: root)
VITE_BASE_PATH=/

# Report API base URL. Leave empty in dev to use Vite proxy (/api → staging).
# Production example: https://elementspoapi-staging.azurewebsites.net
VITE_API_BASE=

# Optional bearer token for authenticated Report API calls in local dev.
# This is sent as `Authorization: Bearer <token>` on every /api/Report/* request.
# Alternatively, sign in through the Element P2P Authenticate flow — the JWT is stored
# in localStorage under the key `Token` (swagger TokenModel) after login + tenant selection.
# VITE_API_TOKEN=your_jwt_here

# Log full Report API request/response in the browser console (enabled by default in dev).
# VITE_REPORT_API_DEBUG=true

# Vite dev-server proxy target (used when VITE_API_BASE is empty).
# VITE_API_PROXY_TARGET=https://elementspoapi-staging.azurewebsites.net
